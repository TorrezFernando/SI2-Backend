# URL de conexión de SQLAlchemy. Sustituye todos los valores de ejemplo.
DATABASE_URL=postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>

# Usada por las operaciones administrativas de respaldo/restauración.
POSTGRES_HOST=<host>
POSTGRES_PORT=<puerto>
POSTGRES_USER=<usuario>
POSTGRES_PASSWORD=<contraseña>
POSTGRES_DB=<base_de_datos>
PG_BIN_PATH=<ruta_al_directorio_bin_de_postgresql>

# Genera valores aleatorios distintos para cada entorno.
JWT_SECRET_KEY=<secreto_jwt>
BITACORA_FERNET_KEY=<llave_fernet>

# Requerida solo para seed.py y para el reseteo temporal de administradores.
SEED_ADMIN_PASSWORD=<contraseña_de_semilla>
DEFAULT_ADMIN_PASSWORD=<contraseña_inicial_o_de_reseteo>
