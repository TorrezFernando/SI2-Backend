# Configuración de Base de Datos PostgreSQL
# Modifica 'tu_contraseña' por tu contraseña real de PostgreSQL
DATABASE_URL=postgresql://postgres:tu_contraseña@localhost:5432/raices_db

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# IDs de usuarios autorizados explícitamente para administrar todas las empresas.
SUPERADMIN_USER_IDS=
ENABLE_SCHEDULER=false
CORS_ORIGINS=http://localhost:4200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Ruta al JSON de cuenta de servicio Firebase (nunca subirlo a Git).
GOOGLE_APPLICATION_CREDENTIALS=
# Activar en un único worker/proceso para evitar envíos duplicados.
ENABLE_FCM_SCHEDULER=false
